# Development package definition. This PKGBUILD has not been submitted to AUR.
pkgname=roam-git
pkgver=0.1.0.r0.g0000000
pkgrel=2
pkgdesc='Local Linux Wi-Fi roaming assistant for selected NetworkManager profiles'
arch=('x86_64' 'aarch64')
url='https://github.com/ossacolsale/roam'
license=('MIT')
depends=('networkmanager' 'systemd' 'gtk4' 'libadwaita' 'util-linux')
makedepends=('git' 'rust' 'cargo' 'pkgconf')
provides=('roam')
conflicts=('roam')
source=("roam::git+https://github.com/ossacolsale/roam.git")
install=roam.install
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/roam"
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/roam"
  cargo build --release --workspace --locked
}

package() {
  cd "$srcdir/roam"
  install -Dm755 target/release/roamd "$pkgdir/usr/bin/roamd"
  install -Dm755 target/release/roam-ui "$pkgdir/usr/bin/roam-ui"
  install -Dm644 systemd/roam.service "$pkgdir/usr/lib/systemd/user/roam.service"
  install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../roam.service "$pkgdir/usr/lib/systemd/user/default.target.wants/roam.service"
  install -Dm644 packaging/org.roam.WifiRoaming.desktop "$pkgdir/usr/share/applications/org.roam.WifiRoaming.desktop"
  install -Dm644 packaging/org.roam.WifiRoaming.metainfo.xml "$pkgdir/usr/share/metainfo/org.roam.WifiRoaming.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/icons/hicolor/scalable/apps/org.roam.WifiRoaming.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.roam.WifiRoaming.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/org.roam.WifiRoaming.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/org.roam.WifiRoaming.png"
  done
}
